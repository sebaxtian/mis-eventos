{
  "$schema": "https://opencode.ai/config.json",
  "providers": {
    "local": {
      "name": "Llama.cpp Local",
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "http://localhost:8088/v1"
      },
      "headers": {
        "Authorization": "Bearer not-needed"
      },
      "models": {
        "Qwen3.5-4B-MTP": {
          "name": "Qwen3.5-4B-MTP",
          "capabilities": {
            "tools": true
          }
        }
      }
    }
  },
  "mcp": {
    "servers": {
      "context7-mcp": {
        "type": "remote",
        "url": "https://mcp.context7.com/mcp",
        "headers": {
          "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}"
        }
      },
      "github-mcp": {
        "type": "remote",
        "url": "https://api.githubcopilot.com/mcp/",
        "oauth": false,
        "headers": {
          "Authorization": "Bearer {env:GITHUB_PERSONAL_ACCESS_TOKEN}"
        }
      },
      "chrome-devtools-mcp": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "chrome-devtools-mcp@1.12.0",
          "--no-usage-statistics",
          "--executablePath",
          "{env:BROWSER_PATH}"
        ]
      },
      "postgres-mcp": {
        "type": "local",
        "command": ["npx", "-y", "@yawlabs/postgres-mcp@0.13.9"],
        "environment": {
          "DATABASE_URL": "{env:DEV_DATABASE_URI}",
          "ALLOW_WRITES": "0"
        }
      }
    }
  }
}
